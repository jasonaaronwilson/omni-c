/**
 * @file build.roci
 *
 * This is the main build for omni-c (and thus roci itself since it is
 * currently part of omni-c).
 *
 * Before trying to build, run the appropriate configure-*.sh script
 * and follow the directions the are printed at the end to do
 * subsequent builds.
 *
 * If you see a Makefile in this repository, it is either deprecated
 * or obsolete (though might contains some interesting targets that
 * need to get added here such as globabl clang-formatting).
 */

let PLATFORM = platform();

let list_maybe_shuffle = list_shuffle;

/**
 * @function exit_compilation
 *
 * A simple wrapper around exit(1) that can print additional
 * information.
 */
let exit_compilation = fn() {
  println("The build was aborted!");
  exit(1);
};

/**
 * @function check_shell_command
 *
 * If the previous shell command was successful, meaning it had exit
 * code of zero, then stay quiet otherwise dump the output from that
 * command and exit_compilation.
 */
let check_shell_command = fn(shell_result) {
  if (not(iequal(shell_exit_code(shell_result), 0))) {
    println("--------------------------------------------------------");
    println("  ERROR: a shell command returned a non-zero exit code.");
    println("--------------------------------------------------------");
    println(shell_command_line(shell_result));
    println("");
    println(shell_stdout(shell_result));
    exit_compilation();
  }
};

/**
 * @function time_thunk
 *
 * Measure the "runtime" of executing a thunk and print to stdout that
 * run-time in milli-seconds.
 */
let time_thunk = fn(thunk) {
  let start_time = current_time_millis();
  let result = thunk();
  let end_time = current_time_millis();
  let run_time = isub(end_time, start_time);
  println(string_append("  |>  ", to_string(run_time), "ms"));
  return result;
};

let time_shell = fn(command_line) {
  let result = time_thunk(fn() {
    let resultx = time_thunk(fn () {
      // FIXME(jawilson): do we need return here?
      shell(command_line);
    });
    return resultx;
  });
  return result;
};

let noisy_shell = fn(command_line) {
  println("About to execute:");
  println(command_line);
  let result = time_thunk(fn() {
    let result = shell(command_line);
    return result;
  });
  return result;
};

/**
 * @function get_c_compiler
 *
 * Try to find a suitable C compiler. If the CC environment variable
 * is set, we are happy to use it (as long as which can find
 * it).
 *
 * When CC environment variable isn't set, we probe for gcc, clang,
 * and tcc in that order.
 */
let get_c_compiler = fn() {

  let probe_c_compiler = fn(cc) {
    // TODO(jawilson): while I have which on windows, other users may
    // not
    let command_line = make_list("which", cc);
    let result = shell(command_line);
    if (iequal(shell_exit_code(result), 0)) {
      println(string_append(cc, " exists"));
      return true;
    }
    return false;
  };

  let env_cc = getenv("CC");

  if (is_string(env_cc)) {
    if (probe_c_compiler(env_cc)) {
      println(string_append("Using user override for C compiler: ", env_cc));
      return env_cc;
    } else {
      println(string_append("User override for C compiler doesn't seem to exist: ", env_cc));
      exit_compilation();
    }
  }

  if (probe_c_compiler("gcc")) {
    return "gcc";
  }
  if (probe_c_compiler("clang")) {
    return "clang";
  }
  if (probe_c_compiler("tcc")) {
    return "tcc";
  }

  println(string_append("No suitable C compiler was found."));
  exit_compilation();
};

/**
 * @function get_warn_flags
 *
 * Each C compiler has it's own warnings so if we are going to turn
 * them on, we unfortunately need to customize this. It's probably
 * worse than this because these warnings flags can be renamed,
 * etc. Unlucky for us, it's not trivial to get at the version of the
 * compiler to help compute this.
 */
let get_warn_flags = fn(cc) {

  if (string_equal(cc, "gcc")) {
    return make_list("-Wall",
      "-Werror",
      "-Wno-error=format",
      "-Wno-format",
      "-Wno-error=return-local-addr",
      "-Wno-unused-function",
      "-Wno-unused-variable");
  }

  if (string_equal(cc, "clang")) {
    return make_list("-Wall",
      "-Werror",
      "-Wno-error=format",
      "-Wno-format",
      "-Wno-error=return-local-addr",
      "-Wno-unused-function",
      "-Wno-unused-variable",
      "-Wno-parentheses-equality",
      "-Wno-c23-extensions");
  }

  return make_list();
};

/**
 * @function get_opt_flags
 *
 * Hopefully this doesn't need to be overly tweaked for compilers.
 */
let get_opt_flags = fn(cc) {
  if (string_equal(cc, "gcc")) {
    return make_list("-O3");
  }
  if (string_equal(cc, "clang")) {
    return make_list("-O3");
  }
  return make_list();
};

// I don't think this much matters...
let add_extra_flags = fn(cc) {
  if (string_equal(cc, "gcc")) {
    list_push(CC_FLAGS, "-std=gnu99");
    return;
  }
  if (string_equal(cc, "clang")) {
    list_push(CC_FLAGS, "-std=gnu99");
    return;
  }
};

/* ====================================================================== */

let CC = get_c_compiler();
let WARN_FLAGS = get_warn_flags(CC);
let OPT_FLAGS = get_opt_flags(CC);

let CC_FLAGS = make_list("-g");
if (string_equal(PLATFORM, "windows")) {
  list_push(CC_FLAGS, "-gcodeview");
} else {
  list_push(CC_FLAGS, "-rdynamic");
}

/* ====================================================================== */

let TARGETS = make_ht(hash, equal);

let add_target = fn(target_name, thunk_or_list) {
  let target = make_list("record-tag:target", target_name, thunk_or_list);
  ht_insert(TARGETS, target_name, target);
};

let get_target = fn(target_name) {
  return ht_find(TARGETS, target_name, false);
};

let target_get_builder = fn(target) {
  return list_get(target, 2);
};

/**
 * @function all_older_than
 *
 * This is the key insight of make - if any dependency is older than
 * the target (or the target doesn't exist), we must rebuild that
 * dependency.
 */
let all_older_than = fn(target, deps) {
  let NEGATIVE_ONE = neg(1);
  let target_timestamp = timestamp(target);

  // target doesn't exist
  if (iequal(target_timestamp, NEGATIVE_ONE)) {
    println(string_append(target, " does not exist"));
    return false;
  }

  let result = true;
  list_for_each(deps, fn(x) {
    // No easy way to exit the loop but no reason to keep checking.
    if (not(result)) {
      return;
    }
    let dep_timestamp = timestamp(x);
    if (iequal(dep_timestamp, NEGATIVE_ONE)) {
      println(string_append("WARNING: ", x, " does not exist"));
      result = false;
    }
    if (igte(dep_timestamp, target_timestamp)) {
      announce_dependency(x, target);
      result = false;
    }
  });
  return result;
};

let announce_build = fn(target) {
  println(string_append("[Building ", target, "]"));
};

let announce_no_build = fn(target) {
  let checkmark = "\u2714 "; // bold checkmark
  println(string_append(checkmark, target, " is up to date"));
};

let announce_dependency = fn(dep, target) {
  let icon = "\u2500 ";
  println(string_append(icon, target, " is stale"));
  println(string_append("  \u2514\u2500\u2500 ", dep, " is newer"));
};

// Refer to a path relative to the root of the build dir.
let build_dir_path = fn(path) {
  return string_append(BUILD_DIR, path);
};

// Rename src_path
let source_file_location = fn(x) {
  return string_append(TOP_DIR, x);
};

let TOP_DIR = string_append(pwd(), "/");
let BUILD_DIR = string_append(TOP_DIR, "build-dir/");
let STABLE_BINARY_PATH = build_dir_path("bin/omni-c-stable");
let OMNI_C = build_dir_path("bin/omni-c");
let OMNI_C_STABLE = build_dir_path("bin/omni-c-stable");

load("src/build-fragment.roci");
load("src/lib/build-fragment.roci");
load("src/roci/build-fragment.roci");

let ALL_OMNI_C_SRC = make_list();
list_push_all(ALL_OMNI_C_SRC, SOURCE_OMNI_C);
list_push_all(ALL_OMNI_C_SRC, SOURCE_LIB);
list_push_all(ALL_OMNI_C_SRC, SOURCE_ROCI);

let RHEADER = build_dir_path("gen-files/reflection-header.c");
list_push(ALL_OMNI_C_SRC, RHEADER);
let ROCI_LIB = build_dir_path("gen-files/roci-lib.c");
list_push(ALL_OMNI_C_SRC, ROCI_LIB);

let generate_embedded_file = fn(variable, input, output) {
  let script = string_append(TOP_DIR, "tools/embed-file.roci");
  let deps = make_list(input, script);

  if (all_older_than(output, deps)) {
    announce_no_build(output);
    return;
  } else {
    announce_build(output);
  }

  let command_line = make_list(build_dir_path("bin/omni-c-stable"),
    "roci",
    "--script",
    script,
    variable,
    input,
    output);
  let result = shell(command_line);
  check_shell_command(result);
};

let uncrustify_roci = fn(filename) {
  let command_line = make_list("uncrustify",
    "-c",
    source_file_location("tools/uncrustify-roci.cfg"),
    "--replace",
    filename);
  check_shell_command(shell(command_line));
};

let format_all_roci = fn() {
  let files = glob("*.roci");
  list_push_all(files, glob("src/roci/*.roci"));
  list_push_all(files, glob("tools/*.roci"));
  list_for_each(files, uncrustify_roci);
};

let clang_format = fn(filename) {
  let command_line = make_list("clang-format", "-style=file", "-i", filename);
  check_shell_command(shell(command_line));
};

let format_all_c = fn() {
  let files = ALL_OMNI_C_SRC;
  list_for_each(files, fn(x) {
    if (string_contains(x, "gen-files/")) {
      return;
    }
    clang_format(x);
  });
};

add_target("format", fn() {
  format_all_roci(); format_all_c();
});

let build_reflection_header = fn() {
  let input = string_append(TOP_DIR, "src/embed/reflection.h");
  generate_embedded_file("reflection_header", input, RHEADER);
};

let build_roci_embedded_lib = fn() {
  let input = string_append(TOP_DIR, "src/roci/roci-lib.roci");
  generate_embedded_file("roci_lib", input, ROCI_LIB);
};

// TODO(jawilson): handle -posix.c as a root suffix and handle
// -linux.c and -darwin.c to be only when posix doesn't quite
// work. This will get rid of symlinks in our source tree.
let is_platform_file = fn(src) {
  if (string_ends_with(src, "-linux.c")) {
    return true;
  }
  if (string_ends_with(src, "-darwin.c")) {
    return true;
  }
  if (string_ends_with(src, "-windows.c")) {
    return true;
  }
  return false;
};

let is_matching_platform = fn(src) {
  if (is_platform_file(src)) {
    let suffix = string_append("-", PLATFORM, ".c");
    return string_ends_with(src, suffix);
  }
  return true;
};

let filter_files_by_platform = fn(sources) {
  let filtered = make_list();
  list_for_each(sources, fn(src) {
    if (is_matching_platform(src)) {
      list_push(filtered, src);
    }
  });
  return filtered;
};

ALL_OMNI_C_SRC = filter_files_by_platform(ALL_OMNI_C_SRC);

/**
 * @function build_omni_c
 *
 * This is the goal, to build "an" omni-c. However, since we are a
 * compiler which has a stable, current, and "self" version, this is
 * parameterized.
 */
let build_omni_c = fn(target_name, c_target_name, omni_c_binary, optimize) {

  if (string_equal(PLATFORM, "windows")) {
    target_name = string_append(target_name, ".exe");
  }

  build_reflection_header();
  build_roci_embedded_lib();

  if (all_older_than(target_name, ALL_OMNI_C_SRC)) {
    announce_no_build(target_name);
    return;
  } else {
    announce_build(target_name);
  }

  // let COMMAND_LINE = make_list("echo");
  let COMMAND_LINE = make_list(omni_c_binary);

  list_push(COMMAND_LINE, "generate-library");

  // Flags to omni-c generate-library
  list_push(COMMAND_LINE, "--c-output-file");
  list_push(COMMAND_LINE, c_target_name);
  // Do we still need this?
  list_push(COMMAND_LINE, "--omit-c-armyknife-include=true");

  list_push_all(COMMAND_LINE, ALL_OMNI_C_SRC);

  let result = shell(COMMAND_LINE);
  check_shell_command(result);

  let CC_COMMAND_LINE = make_list(CC);
  list_push_all(CC_COMMAND_LINE, CC_FLAGS);
  list_push_all(CC_COMMAND_LINE, WARN_FLAGS);
  list_push_all(CC_COMMAND_LINE, OPT_FLAGS);
  if (string_equal(PLATFORM, "darwin")) {
    list_push(CC_COMMAND_LINE, "-w"); // Turn off all warnings
    list_push(CC_COMMAND_LINE, "-I/opt/homebrew/opt/bdw-gc/include");
    list_push(CC_COMMAND_LINE, "-L/opt/homebrew/opt/bdw-gc/lib");
  }
  if (string_equal(PLATFORM, "windows")) {
    list_push(CC_COMMAND_LINE, "-Wno-deprecated-declarations");
    list_push(CC_COMMAND_LINE, "-Wno-pointer-sign");
    list_push(CC_COMMAND_LINE, "-Ic:/Users/jason/vcpkg/installed/x64-windows-static/include");
    list_push(CC_COMMAND_LINE, "c:/Users/jason/vcpkg/installed/x64-windows-static/lib/gc.lib");
    list_push(CC_COMMAND_LINE, "-ldbghelp");
    list_push(CC_COMMAND_LINE, "-lwinmm");
    list_push(CC_COMMAND_LINE, "-Wl,-debug");
  }

  list_push(CC_COMMAND_LINE, "-o");
  list_push(CC_COMMAND_LINE, target_name);

  // the output from omni-c is now the input to CC
  list_push(CC_COMMAND_LINE, c_target_name);

  if (not(string_equal(PLATFORM, "windows"))) {
    list_push(CC_COMMAND_LINE, "-lgc");
  }

  let cc_result = shell(CC_COMMAND_LINE);
  check_shell_command(cc_result);
};

add_target(build_dir_path("bin/omni-c"),
  fn() {
  build_omni_c(build_dir_path("bin/omni-c"),
    build_dir_path("omni-c.c"),
    build_dir_path("bin/omni-c-stable"),
    false);
});

add_target(build_dir_path("bin/self"),
  fn() {
  build_omni_c(build_dir_path("bin/self"),
    build_dir_path("omni-c-self.c"),
    build_dir_path("bin/omni-c"),
    true);
});

add_target(build_dir_path("bin/self-no-opt"),
  fn() {
  build_omni_c(build_dir_path("bin/self"),
    build_dir_path("omni-c-self.c"),
    build_dir_path("bin/omni-c"),
    false);
});

let build_lib_oar = fn() {
  let target = build_dir_path("bin/lib.oar");
  let sources = filter_files_by_platform(SOURCE_LIB);

  if (all_older_than(target, sources)) {
    announce_no_build(target);
    return;
  } else {
    announce_build(target);
  }

  let command = make_list(build_dir_path("bin/omni-c-stable"),
    "archive", "--archive-output-file", target);
  list_push_all(command, sources);
  let result = shell(command);
  check_shell_command(result);
};

add_target(build_dir_path("bin/lib.oar"), build_lib_oar);

let build_lib_roci = fn() {
  let target = build_dir_path("bin/lib-roci.oar");
  let sources = filter_files_by_platform(SOURCE_ROCI_LIB);

  if (all_older_than(target, sources)) {
    announce_no_build(target);
    return;
  } else {
    announce_build(target);
  }

  let command = make_list(build_dir_path("bin/omni-c-stable"),
    "archive", "--archive-output-file", target);
  list_push_all(command, sources);
  let result = shell(command);
  check_shell_command(result);
};

add_target(build_dir_path("bin/lib-roci.oar"), build_lib_roci);
add_target("lib-roci", build_lib_roci);

let TESTS = make_list();
let STATEMENT_TESTS = glob("tests/statements/*.stmt");
let EXPRESSION_TESTS = glob("tests/expressions/*.expr");

list_push_all(TESTS, STATEMENT_TESTS);
list_push_all(TESTS, EXPRESSION_TESTS);

list_push(TESTS, "tests/always-passing-test.sh");
list_push(TESTS, "tests/lib/buffer-test.c");
list_push(TESTS, "tests/lib/cdl-printer-test.c");
list_push(TESTS, "tests/lib/random-test.c");
list_push(TESTS, "tests/lib/quote-util-test.c");
list_push(TESTS, "tests/lib/splitjoin-test.c");
list_push(TESTS, "tests/lib/string-alist-test.c");
list_push(TESTS, "tests/lib/string-hashtable-test.c");
list_push(TESTS, "tests/lib/string-tokenizer-test.c");
list_push(TESTS, "tests/lib/string-tree-test.c");
list_push(TESTS, "tests/lib/string-util-test.c");
list_push(TESTS, "tests/lib/sub-process-test.c");
list_push(TESTS, "tests/lib/terminal-test.c");
list_push(TESTS, "tests/lib/uint64-test.c");
list_push(TESTS, "tests/lib/value-alist-test.c");
list_push(TESTS, "tests/lib/value-array-test.c");
list_push(TESTS, "tests/lib/value-tree-test.c");

list_push(TESTS, "tests/roci/roci-symbol-table-test.c");

let run_roci_tests = fn(omni_c) {
  let command_line =
    make_list(omni_c, "roci", "--script", "src/roci/roci-test.roci");
  let test_result = noisy_shell(command_line);
  check_shell_command(test_result);
};

let run_tests = fn(omni_c) {

  run_roci_tests(omni_c);

  let command_line = make_list();
  list_push(command_line, string_append("OMNI_C_ROOT=", TOP_DIR));
  list_push(command_line, string_append("BUILD_DIR=", BUILD_DIR));
  list_push(command_line, omni_c);
  list_push(command_line, "roci");
  list_push(command_line, "--script");
  list_push(command_line, "tools/run-tests.roci");
  list_push_all(command_line, TESTS);

  let test_result = noisy_shell(command_line);
  check_shell_command(test_result);
};

add_target("test", fn() {
  build_target(build_dir_path("bin/omni-c"));
  build_target(build_dir_path("bin/lib.oar"));
  build_target(build_dir_path("bin/lib-roci.oar"));
  run_tests(build_dir_path("bin/omni-c"));
});

let build_target = fn(target_name) {
  let target = get_target(target_name);
  if (is_boolean(target)) {
    println(string_append("The requested target was not found: ", target_name));
    exit_compilation();
  }
  let builder = target_get_builder(target);
  if (is_list(builder)) {
    list_for_each(builder, build_target);
  } else {
    builder();
  }
};

add_target("all", make_list(build_dir_path("bin/omni-c"),
  build_dir_path("bin/self"),
  build_dir_path("bin/lib.oar")));

add_target("clean", fn() {
  walk_directory(BUILD_DIR, true, fn(name) {
    let can_remove = true;
    can_remove = boolean_and(can_remove, not(string_ends_with(name, "omni-c-stable")));
    can_remove = boolean_and(can_remove, not(string_ends_with(name, "build-dir/bin")));
    can_remove = boolean_and(can_remove, not(string_ends_with(name, "build-dir/gen-files")));
    can_remove = boolean_and(can_remove, not(string_ends_with(name, "build-dir/tmp")));
    if (can_remove) {
      path_remove(name);
    }
  });
});

add_target("cloc", fn() {

  let files = make_list();
  list_push_all(files, glob("src/*.c"));
  list_push_all(files, glob("src/lib/*.c"));
  list_push_all(files, glob("src/roci/*.c"));
  list_push_all(files, glob("src/roci/*.roci"));

  // This can also be useful... --by-file
  let command_line = make_list("cloc", "--force-lang=Java,roci");
  list_for_each(files, fn(filename) {
    if (string_ends_with(filename, "omni-c-stable.c")) {
      return;
    }
    if (string_ends_with(filename, "omni-c-stable-darwin.c")) {
      return;
    }
    if (string_ends_with(filename, "omni-c-stable-linux.c")) {
      return;
    }
    list_push(command_line, filename);
  });
  // println(command_line);
  let shell_result = shell(command_line);
  let out = shell_stdout(shell_result);
  // TODO(jawilson): string_replace_all(shell_result, "Java", "roci");
  println(shell_stdout(shell_result));
});

//
// lib-examples:
//	@$(MAKE) -C lib/lib/examples examples
//


/* ====================================================================== */

let main = fn() {
  let args = command_line_args();

  if (igt(list_length(args), 0)) {
    list_for_each(args, build_target);
  } else {
    build_target("all");
  }
};
main();

/*
   LIB_TESTS := \
        ${OMNI_C_ROOT}/tests/lib/flag-test.sh \
        ${OMNI_C_ROOT}/tests/lib/io-test.sh

   // uncrustify -c tools/uncrustify-roci.cfg --replace ./build.roci

 */
