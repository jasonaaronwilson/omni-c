/**
 * @file roci-lib.roci
 *
 * These are built-in roci functions which can be written in roci
 * instead of the lowest level primitives that are written in C.
 */

let list_map = fn(lst, func) {
  let result = make_list();
  list_for_each(lst, fn(x) {
      list_push(result, func(x));
    });
  return result;
};

let list_push_all = fn(lst0, lst1) {
  list_for_each(lst1, fn(x) {
      list_push(lst0, x);
    });
};

// This may fail for long lists since we aren't properly tail
// recursive yet.
let list_find_index = fn(lst, predicate) {
  let next = fn(index) {
    if (igte(index, list_length(lst))) {
      return neg(1);
    }
    let list_item = list_get(lst, index);
    if (predicate(list_item)) {
      return index;
    }
    return next(iadd(index, 1));
  };
  return next(0);
};

let list_index_of = fn(lst, item) {
  return list_find_index(lst, fn(x) { return equal(item, x); });
};

let to_display_string = fn(x) {
  if (is_string(x)) {
    return x;
  }
  if (is_buffer(x)) {
    return buffer_to_string(x);
  }
  return to_string(x);
};

let buffer_printf_lst_loop = fn(buffer, format, lst, lst_start) {
  let split_point = string_index_of(format, "%s");
  if (ilt(split_point, 0)) {
    // TODO(jawilson): warn or error if lst not consumed?
    buffer_append_string(buffer, format);
    return;
  }
  if (igt(split_point, 0)) {
    buffer_append_string(buffer, string_substring(format, 0, split_point));
  }
  buffer_append_string(buffer, to_display_string(list_get(lst, lst_start)));
  let format_len = string_length_bytes(format);
  if (igte(split_point, isub(format_len, 2))) {
    return;
  }
  buffer_printf_lst_loop(buffer,
			 string_substring(format, iadd(split_point, 2), format_len),
			 lst,
			 iadd(lst_start, 1));
};

let buffer_printf_lst = fn(buffer, format, lst) {
  buffer_printf_lst_loop(buffer, format, lst, 0);
};

// TODO(jawilson): once we have rest arguments, implement buffer_printf

let string_printf_list = fn(format, lst) {
  let buffer = make_buffer();
  buffer_printf_lst(buffer, format, lst);
  return buffer_to_string(buffer);
};

// alists

let make_alist = fn(equal_fn) {
  return make_list("record-tag:alist", equal_fn, make_list(), make_list());
};

let is_alist = fn(x) {
  if (not(is_list(x))) {
    return false;
  }
  return string_equal("record-tag:alist", list_get(x, 0));
};

let alist_equal_fn = fn(alist) {
  if (not(is_alist(alist))) {
    debug_error("alist_keys expects an alist as the first argument");
  }
  return list_get(alist, 1);
};

let alist_keys = fn(alist) {
  if (not(is_alist(alist))) {
    debug_error("alist_keys expects an alist as the first argument");
  }
  return list_get(alist, 2);
};

let alist_values = fn(alist) {
  if (not(is_alist(alist))) {
    debug_error("alist_values expects an alist as the first argument");
  }
  return list_get(alist, 3);
};

let alist_length = fn(alist) {
  return list_length(alist_keys(alist));
};

let alist_for_each = fn(alist, func) {
  for_each_integer(0, list_length(alist_keys(alist)),
    fn(index) {
      let key = list_get(alist_keys(alist), index);
      let value = list_get(alist_values(alist), index);
      func(key, value);
    });
};

let alist_find_position = fn(alist, search_key) {
  let position = 0;
  let first_match = neg(1);
  let eq_fn = alist_equal_fn(alist);
  alist_for_each(alist, fn(key, value) {
    if (ilt(first_match, 0)) {
      if (eq_fn(search_key, key)) {
        first_match = position;
      }
    }
    position = iadd(position, 1);
  });
  return first_match;
};

let alist_find = fn(alist, key, not_found_value) {
  let position = alist_find_position(alist, key);
  if (igte(position, 0)) {
    return list_get(alist_values(alist), position);
  }
  return not_found_value;
};

let alist_insert = fn(alist, key, value) {
  let position = alist_find_position(alist, key);
  if (igte(position, 0)) {
    list_set(alist_values(alist), position, value);
    return;
  }
  list_push(alist_keys(alist), key);
  list_push(alist_values(alist), value);
};

let alist_delete = fn(alist, key) {
  let position = alist_find_position(alist, key);
  if (igte(position, 0)) {
    list_delete_at(alist_keys(alist), position);
    list_delete_at(alist_values(alist), position);
  }
};
