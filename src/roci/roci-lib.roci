///
/// @file roci-lib.roci
///
/// These are built-in roci functions which can be written in roci
/// instead of the lowest level primitives that are written in C.
///

let list_map = fn(lst, func) {
  let result = make_list();
  list_for_each(lst, fn(x) {
    list_push(result, func(x));
  });
  return result;
};

let list_copy = fn(lst) {
  let id = fn(x) {
    return x;
  };
  return list_map(lst, id);
};

let list_push_all = fn(lst0, lst1) {
  list_for_each(lst1, fn(x) {
    list_push(lst0, x);
  });
};

// This may fail for long lists since we aren't properly tail
// recursive yet.
let list_find_index = fn(lst, predicate) {
  let next = fn(index) {
    if (igte(index, list_length(lst))) {
      return neg(1);
    }
    let list_item = list_get(lst, index);
    if (predicate(list_item)) {
      return index;
    }
    return next(iadd(index, 1));
  };
  return next(0);
};

let list_index_of = fn(lst, item) {
  return list_find_index(lst, fn(x) {
    return equal(item, x);
  });
};

let list_shuffle = fn(lst) {

  let list_swap = fn(lst, i, j) {
    let element_i = list_get(lst, i);
    let element_j = list_get(lst, j);
    list_set(lst, i, element_j);
    list_set(lst, j, element_i);
  };

  let len = list_length(lst);
  for_each_integer(0, len, fn(i) {
    let j = irem(bit_and(random_int(), 0xffffffff), len);
    list_swap(lst, i, j);
  });
  return lst;
};


let to_display_string = fn(x) {
  if (is_string(x)) {
    return x;
  }
  if (is_buffer(x)) {
    return buffer_to_string(x);
  }
  return to_string(x);
};

let buffer_printf_lst_loop = fn(buffer, format, lst, lst_start) {
  let split_point = string_index_of(format, "%s");
  if (ilt(split_point, 0)) {
    // TODO(jawilson): warn or error if lst not consumed?
    buffer_append_string(buffer, format);
    return;
  }
  if (igt(split_point, 0)) {
    buffer_append_string(buffer, string_substring(format, 0, split_point));
  }
  buffer_append_string(buffer, to_display_string(list_get(lst, lst_start)));
  let format_len = string_length_bytes(format);
  if (igte(split_point, isub(format_len, 2))) {
    return;
  }
  buffer_printf_lst_loop(buffer,
    string_substring(format, iadd(split_point, 2), format_len),
    lst,
    iadd(lst_start, 1));
};

let buffer_printf_lst = fn(buffer, format, lst) {
  buffer_printf_lst_loop(buffer, format, lst, 0);
};

/**
 * @function buffer_printf
 *
 * This is like printf in C but the *only* format specifier allowed is
 * "%s" which acts as universal placeholder (so to_string() it called
 * on non-string arguments).
 *
 * The formated string is appended to the given buffer.
 */
let buffer_printf = fn(buffer, format, ... lst) {
  return buffer_printf_lst(buffer, format, lst);
};

let sprintf = fn(format, ... lst) {
  let buffer = make_buffer();
  buffer_printf_lst(buffer, format, lst);
  return buffer_to_string(buffer);
};

let string_printf_list = fn(format, lst) {
  let buffer = make_buffer();
  buffer_printf_lst(buffer, format, lst);
  return buffer_to_string(buffer);
};

/**
 * @function printf
 *
 * This is like printf in C but the *only* format specifier allowed is
 * "%s" which acts as universal placeholder (so to_string() is called
 * on non-string arguments).
 *
 * The formated string is sent to stdout.
 */
let printf = fn(... lst) {
  return print_string(apply(sprintf, lst));
};

/* ====================================================================== */
/* alists (association lists)                                             */
/* ====================================================================== */

record alist {
  equal_fn,
  keys,
  values,
}

let make_alist_full = make_alist;

make_alist = fn(equal_fn) {
  return make_alist_full(equal_fn, make_list(), make_list());
};

let alist_equal_fn = fn(alist) {
  return alist.equal_fn;
};

let alist_keys = fn(alist) {
  return alist.keys;
};

let alist_values = fn(alist) {
  return alist.values;
};

let alist_length = fn(alist) {
  return list_length(alist_keys(alist));
};

let alist_for_each = fn(alist, func) {
  for_each_integer(0, list_length(alist.keys),
    fn(index) {
    let key = list_get(alist.keys, index);
    let value = list_get(alist.values, index);
    func(key, value);
  });
};

let alist_find_position = fn(alist, search_key) {
  let position = 0;
  let first_match = neg(1);
  let eq_fn = alist_equal_fn(alist);
  alist_for_each(alist, fn(key, value) {
    if (first_match < 0) {
      if (eq_fn(search_key, key)) {
        first_match = position;
      }
    }
    position = position + 1;
  });
  return first_match;
};

let alist_find = fn(alist, key, not_found_value) {
  let position = alist_find_position(alist, key);
  if (position >= 0) {
    return list_get(alist_values(alist), position);
  }
  return not_found_value;
};

let alist_insert = fn(alist, key, value) {
  let position = alist_find_position(alist, key);
  if (position >= 0) {
    list_set(alist_values(alist), position, value);
    return;
  }
  list_push(alist_keys(alist), key);
  list_push(alist_values(alist), value);
};

let alist_delete = fn(alist, key) {
  let position = alist_find_position(alist, key);
  if (position >= 0) {
    list_delete_at(alist_keys(alist), position);
    list_delete_at(alist_values(alist), position);
  }
};

/* ====================================================================== */
/* hashtables                                                             */
/* ====================================================================== */

let _make_array_of_empty_alists = fn(equal_fn, length) {
  let lst = make_list();
  for_each_integer(0, length, fn(i) {
    list_push(lst, make_alist(equal_fn));
  });
  return lst;
};

// This is not tuned in anyway except asking for
// NOT USED YET -- let ROCI_HT_LOAD_FACTOR = 1.0;

record ht {
  hash_fn, equal_fn, length, buckets,
}

let make_ht_full = make_ht;

make_ht = fn(hash_fn, equal_fn) {
  let buckets = _make_array_of_empty_alists(equal_fn, 4);
  let result = make_ht_full(hash_fn, equal_fn, 0, buckets);
  return result;
};

let ht_hash = fn(ht, key) {
  let hash_fn = ht.hash_fn;
  return hash_fn(key);
};

let ht_alist = fn(ht, key) {
  let hash_fn = ht.hash_fn;
  let hash = hash_fn(key);
  let buckets = ht.buckets;
  let bucket_number = irem(hash, list_length(buckets));
  return list_get(buckets, bucket_number);
};

let ht_should_resize = fn(ht) {
  return ht.length > list_length(ht.buckets);
};

let ht_for_each = fn(ht, func) {
  let buckets = ht_get_buckets(ht);
  for_each_integer(0, list_length(buckets),
    fn(index) {
    let bucket = list_get(buckets, index);
    alist_for_each(bucket, func);
  });
};

let _ht_mutate = fn(ht, alist, thunk) {
  let length_before = alist_length(alist);
  thunk();
  let length_after = alist_length(alist);
  ht.length = ht.length + (length_after - length_before);
  if (ht_should_resize(ht)) {
    // println(string_append("Resizing ht = ", to_string(ht)));
    let new_num_buckets = list_length(ht_get_buckets(ht)) * 2;
    let new_ht = make_ht(ht.hash_fn, ht.equal_fn);
    new_ht.buckets = _make_array_of_empty_alists(ht.equal_fn, new_num_buckets);
    ht_for_each(ht, fn(key, value) {
      ht_insert(new_ht, key, value);
    });
    ht.buckets = new_ht.buckets;
    // Make sure new_ht.length is the same as ht.length
  }
};

let ht_find = fn(ht, key, not_found_value) {
  let alist = ht_alist(ht, key);
  return alist_find(alist, key, not_found_value);
};

let ht_insert = fn(ht, key, value) {
  let alist = ht_alist(ht, key);
  _ht_mutate(ht, alist, fn() {
    alist_insert(alist, key, value);
  });
};

let ht_delete = fn(ht, key) {
  let alist = ht_alist(ht, key);
  _ht_mutate(ht, alist, fn() {
    alist_delete(alist, key);
  });
};

/* ====================================================================== */
/* Extra Path Functions */
/* ====================================================================== */

let walk_directory = fn(dir, include_dirs, callback) {
  let files = glob(string_append(dir, "*"));
  list_for_each(files, fn(x) {
    if (path_is_directory(x)) {
      walk_directory(string_append(x, "/"), include_dirs, callback);
      if (include_dirs) {
        callback(x);
      }
    } else {
      callback(x);
    }
  });
};
