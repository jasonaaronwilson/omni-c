//// This roci script is loaded by the master roci build file.

// Normally we would just use a glob but lib still has some things
// don't don't topologically sort correctly (hopefully just inlined
// functions).

// let __start_time = current_time_millis();

let _PERMUTABLE_ = make_list();

list_push_all(_PERMUTABLE_, glob("src/lib/*.c"));
list_push_all(_PERMUTABLE_, glob("src/lib/io/*.c"));
list_push_all(_PERMUTABLE_, glob("src/lib/tui/*.c"));
list_push_all(_PERMUTABLE_, glob("src/lib/collections/*.c"));
list_push_all(_PERMUTABLE_, glob("src/lib/lang/*.c"));
list_push_all(_PERMUTABLE_, glob("src/lib/string/*.c"));
list_push_all(_PERMUTABLE_, glob("src/lib/runtime/*.c"));

// Let's randomly shuffle these to make sure we don't make the
// ordering problem any worse though this is not a good long term
// strategy.

let _LIB_SRC_ = list_maybe_shuffle(_PERMUTABLE_);

// let __end_time = current_time_millis();
// printf("Total millis was %s\n", isub(__end_time, __start_time));

let SOURCE_LIB = list_map(_LIB_SRC_, fn(x) {
    return string_append(TOP_DIR, x);
  });
