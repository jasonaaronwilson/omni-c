//// This roci script is loaded by the master roci build file.

// Normally we would just use a glob but lib still has some things
// don't don't topologically sort correctly (hopefully just inlined
// functions).

//
// This is a copy of list_shuffle from roci-lib.roci. It won't be
// needed once that file is in stable.
//

let _LIB_SRC_ = make_list(
   "platform-linux.c",
   "platform-darwin.c",
   "includes.c",
   "omni-c.c",
   "min-max.c",
   "leb128.c",
   "fatal-error-darwin.c",
   "fatal-error-linux.c",
   "fatal-error.c",
   "time.c",
   "gc-allocate.c",
   "string-util.c",
   "utf8-decoder.c",
   "buffer.c",
   "byte-stream.c",
   "flag.c",
   "tokenizer.c",
   "random.c",
   "cdl-printer.c",
   "splitjoin.c",
   "oarchive.c",
   "quote-util.c",
   "test.c",
);

let glob_without_src_lib = fn(pattern) {
  // Remove src/lib/ since we tack back on src/lib below
  return list_map(glob(pattern), fn(path) { return string_replace_all(path, "src/lib/", ""); });
};

let _PERMUTABLE_ = make_list();

list_push_all(_PERMUTABLE_, glob_without_src_lib("src/lib/io/*.c"));
list_push_all(_PERMUTABLE_, glob_without_src_lib("src/lib/tui/*.c"));
list_push_all(_PERMUTABLE_, glob_without_src_lib("src/lib/collections/*.c"));
list_push_all(_PERMUTABLE_, glob_without_src_lib("src/lib/lang/*.c"));

// Let's randomly shuffle these to make sure we don't make the
// ordering problem any worse though this is not a good long term
// strategy.

list_push_all(_LIB_SRC_, list_shuffle(_PERMUTABLE_));

let SOURCE_LIB = list_map(_LIB_SRC_, fn(x) {
    let prefix = string_append(TOP_DIR, "src/lib/");
    return string_append(prefix, x);
  });
