//// This roci script is loaded by the master roci build file.

// Normally we would just use a glob but lib still has some things
// don't don't topologically sort correctly (hopefully just inlined
// functions).

//
// This is a copy of list_shuffle from roci-lib.roci. It won't be
// needed once that file is in stable.
//

let _LIB_SRC_ = make_list(
   "platform-linux.c",
   "platform-darwin.c",
   "includes.c",
   "omni-c.c",
   "min-max.c",
   "boolean.c",
   "compound-literal.c",
   "fn.c",
   "leb128.c",
   "fatal-error-darwin.c",
   "fatal-error-linux.c",
   "fatal-error.c",
   "time.c",
   "value.c",
   "gc-allocate.c",
   "uint64.c",
   "double.c",
   "string-util.c",
   "logger.c",
   "utf8-decoder.c",
   "buffer.c",
   "byte-stream.c",
   "value-array.c",
   "value-alist.c",
   "string-alist.c",
   "value-hashtable.c",
   "string-hashtable.c",
   "value-tree.c",
   "string-tree.c",
   "flag.c",
   "tokenizer.c",
   "random.c",
   "cdl-printer.c",
   "splitjoin.c",
   "oarchive.c",
   "quote-util.c",
   "test.c",
);

let _PERMUTABLE_ = make_list();

// When false...
// ["src/lib/io/io-darwin.c", "src/lib/io/io-linux.c", "src/lib/io/io.c", "src/lib/io/path.c", "src/lib/io/sub-process.c"]
// When true...
// ["io/io.c", "io/io-darwin.c", "io/io-linux.c", "io/sub-process.c", "io/path.c"]

if (true) {
  list_push_all(_PERMUTABLE_, make_list("io/io.c", "io/io-darwin.c", "io/io-linux.c", "io/sub-process.c", "io/path.c"));
} else {
  let the_glob = glob("src/lib/io/*.c");
  list_map(the_glob, fn(path) {
      return string_replace_all(path, "src/lib/", "");
    });
  println(the_glob);
  list_push_all(_PERMUTABLE_, the_glob);
}

println(_PERMUTABLE_);

list_push_all(_PERMUTABLE_, make_list("tui/terminal.c", "tui/screen.c", "tui/style.c"));

// Let's randomly shuffle these to make sure we don't make the
// ordering problem any worse. This is actually a terrible idea in too
// many ways to count (so ideally should be used for a stable target
// though in some ways it might end up being a source of confidence
// that source order doesn't matter (it unforunately does with inline
// functions that should be ordered).

list_push_all(_LIB_SRC_, list_shuffle(_PERMUTABLE_));

let SOURCE_LIB = list_map(_LIB_SRC_, fn(x) {
    let prefix = string_append(TOP_DIR, "src/lib/");
    return string_append(prefix, x);
  });
